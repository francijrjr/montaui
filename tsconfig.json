{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "lib": ["ES2020", "DOM"],
    "paths": {
      "@/lib/utils": ["./registry/utils.ts"],
      "@/components/monta-ui/*": ["./registry/ui/*"]
    }
  },
  "include": ["registry/ui/**/*.tsx", "components/**/*.tsx", "examples/**/*.tsx"]
}
